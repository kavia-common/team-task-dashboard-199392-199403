{"is_source_file": true, "format": "bash", "description": "A shell script that detects and backs up various database types (SQLite, PostgreSQL, MySQL, MongoDB) by checking for their presence and performing respective backup commands.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "sudo", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump", "cp", "echo"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres ${PG_BIN}/pg_isready", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet", "cp \"${DB_NAME}\" \"database_backup.db\"", "echo \"Backing up SQLite database...\"", "echo \"Backing up PostgreSQL database...\"", "echo \"Backing up MySQL database...\"", "echo \"Backing up MongoDB database...\"", "echo \"\u26a0 No running database detected\"", "exit 0", "exit 1"], "search-terms": ["backup_db.sh", "database_backup", "SQLite", "PostgreSQL", "MySQL", "MongoDB", "database detection", "db_isready"], "state": 2, "file_id": 1, "knowledge_revision": 13, "git_revision": "3724b5542906c81f176c7977fc964d1f36728a03", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "task_management_database", "filename": "task_management_database/backup_db.sh", "revision_history": [{"13": "3724b5542906c81f176c7977fc964d1f36728a03"}]}